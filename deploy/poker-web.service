[Unit]
Description=Texas Hold'em Poker Web (Docker Compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Set WorkingDirectory to your project path on the Raspberry Pi
WorkingDirectory=/home/pi/poker

ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
